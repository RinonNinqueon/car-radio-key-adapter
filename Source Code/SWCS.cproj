<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <SchemaVersion>2.0</SchemaVersion>
    <ProjectVersion>6.1</ProjectVersion>
    <ToolchainName>com.HPInfoTech.CodeVisionAVR.C</ToolchainName>
    <ProjectGuid>{44783508-423D-497C-A76A-A46C3F34E8A0}</ProjectGuid>
    <avrdevice>ATtiny84A</avrdevice>
    <avrdeviceseries>none</avrdeviceseries>
    <OutputType>Executable</OutputType>
    <Language>C</Language>
    <OutputFileName>$(MSBuildProjectName)</OutputFileName>
    <OutputFileExtension>.cof</OutputFileExtension>
    <OutputDirectory>$(MSBuildProjectDirectory)\$(Configuration)</OutputDirectory>
    <AssemblyName>SWCS</AssemblyName>
    <Name>SWCS</Name>
    <RootNamespace>SWCS</RootNamespace>
    <ToolchainFlavour>Native</ToolchainFlavour>
    <KeepTimersRunning>true</KeepTimersRunning>
    <OverrideVtor>false</OverrideVtor>
    <OverrideVtorValue />
    <eraseonlaunchrule>0</eraseonlaunchrule>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <ToolchainSettings>
      <CV>
        <CVProjectPath>"SWCS.prj"</CVProjectPath>
      </CV>
    </ToolchainSettings>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <ToolchainSettings>
      <CV>
        <CVProjectPath>"SWCS.prj"</CVProjectPath>
      </CV>
    </ToolchainSettings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="74hc595.c">
      <SubType>compile</SubType>
    </Compile>
    <Compile Include="ad5245.c">
      <SubType>compile</SubType>
    </Compile>
    <Compile Include="buttons.c">
      <SubType>compile</SubType>
    </Compile>
    <Compile Include="encoder.c">
      <SubType>compile</SubType>
    </Compile>
    <Compile Include="leds.c">
      <SubType>compile</SubType>
    </Compile>
    <Compile Include="menu.c">
      <SubType>compile</SubType>
    </Compile>
    <Compile Include="menu_root.c">
      <SubType>compile</SubType>
    </Compile>
    <Compile Include="menu_idle.c">
      <SubType>compile</SubType>
    </Compile>
    <Compile Include="menu_learning.c">
      <SubType>compile</SubType>
    </Compile>
    <Compile Include="menu_brightness.c">
      <SubType>compile</SubType>
    </Compile>
    <Compile Include="menu_button_select.c">
      <SubType>compile</SubType>
    </Compile>
    <Compile Include="menu_button_code.c">
      <SubType>compile</SubType>
    </Compile>
    <Compile Include="pca9685.c">
      <SubType>compile</SubType>
    </Compile>
    <Compile Include="SWCS.c">
      <SubType>compile</SubType>
    </Compile>
  </ItemGroup>
  <Import Project="$(AVRSTUDIO_EXE_PATH)\\vs\\CV.targets" />
</Project>
